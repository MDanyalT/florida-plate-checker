# Official FLHSMV form. Keep this URL on the official services.flhsmv.gov domain.
FLHSMV_URL=https://services.flhsmv.gov/MVCheckPersonalPlate/PlateInquiryView.aspx
DATA_DIRECTORY=user_data
DATABASE_PATH=user_data/plates.db
OPEN_BROWSER=false
HEADLESS=false
DEVELOPMENT_MODE=false
CHECK_SPEED_PROFILE=conservative
# Optional timing overrides. Leave commented to use the selected profile.
# CHECK_DELAY_MIN_SECONDS=5
# CHECK_DELAY_MAX_SECONDS=10
# RESULT_TIMEOUT_SECONDS=45
# RETRY_DELAY_SECONDS=3
# MAX_RETRIES=3
NAVIGATION_TIMEOUT_MS=45000
MAX_BATCH_SIZE=5
MAX_PLATE_LENGTH=7
MAX_PLATES_PER_RUN=1000
LARGE_RUN_CONFIRMATION_THRESHOLD=100
MAX_UPLOAD_BYTES=2097152
DEBUG_DIRECTORY=user_data/debug
